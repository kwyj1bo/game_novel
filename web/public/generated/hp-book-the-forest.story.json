    "scene_1": {
      "location": "forbidden_forest",
      "cast": {
        "harry": "auto_1",
        "malfoy": "auto_2",
        "hagrid": "auto_3"
      },
      "beats": [
        {
          "camera": "wide",
          "ms": 0
        },
        {
          "music": "mystery"
        },
        {
          "narrate": "Tall trees closed over the path, and the moon barely reached the ground."
        },
        {
          "narrate": "Malfoy stopped walking."
        },
        {
          "look": "malfoy",
          "at": "hagrid"
        },
        {
          "camera": "close",
          "on": "malfoy",
          "ms": 500
        },
        {
          "say": "malfoy",
          "text": "I'm not going in there,"
        },
        {
          "look": "malfoy",
          "at": "hagrid"
        },
        {
          "camera": "close",
          "on": "malfoy",
          "ms": 500
        },
        {
          "say": "malfoy",
          "text": "My father will hear about this."
        },
        {
          "spawn": "hound",
          "at": "auto_threat"
        },
        {
          "sfx": "growl"
        },
        {
          "narrate": "Hagrid's huge hound growled and pressed against his legs."
        },
        {
          "narrate": "Malfoy screamed and ran back down the path."
        },
        {
          "camera": "medium",
          "on": "hound",
          "ms": 700
        },
        {
          "act": "back_away",
          "actor": "hound",
          "target": "malfoy"
        },
        {
          "narrate": "The hound backs away from Malfoy."
        },
        {
          "narrate": "Harry did not run."
        },
        {
          "camera": "close",
          "on": "harry",
          "ms": 600
        }
      ],
      "title": "The Forbidden Forest",
      "choice": {
        "prompt": "What should Harry do?",
        "seconds": 10,
        "options": [
          {
            "label": "Raise your wand",
            "correct": true,
            "goto": "scene_2"
          },
          {
            "label": "Lower your wand",
            "correct": false,
            "goto": "scene_1_wrong"
          }
        ]
      }
    },
