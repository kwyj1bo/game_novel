  "scenes": {
    "scene_1_wrong": {
      "location": "forbidden_forest",
      "cast": {
        "harry": "auto_1",
        "hound": "auto_threat",
        "malfoy": "auto_2"
      },
      "beats": [
        {
          "camera": "medium",
          "on": "harry",
          "ms": 500
        },
        {
          "narrate": "Harry hesitates — and chooses to hold back."
        },
        {
          "move": "harry",
          "to": "auto_entry",
          "async": true
        },
        {
          "camera": "low",
          "on": "hound",
          "ms": 600
        },
        {
          "sfx": "roar"
        },
        {
          "anim": "hound",
          "clip": "roar"
        },
        {
          "together": [
            {
              "anim": "hound",
              "clip": "lunge"
            },
            {
              "fx": "shake",
              "ms": 700
            }
          ]
        },
        {
          "together": [
            {
              "anim": "harry",
              "clip": "fall",
              "hold": true
            },
            {
              "sfx": "thud"
            }
          ]
        },
        {
          "fx": "red_out",
          "ms": 1500
        }
      ],
      "ending": {
        "kind": "death",
        "title": "Wrong Turn",
        "text": "In the book, Harry chose to step towards the clearing. Choosing to hold back ended the story here."
      }
    },
    "scene_1": {
      "location": "forbidden_forest",
      "cast": {
        "harry": "auto_1",
        "malfoy": "auto_2"
      },
      "beats": [
        {
          "camera": "wide",
          "ms": 0
        },
        {
          "music": "mystery"
        },
        {
          "narrate": "Tall trees closed over the path, and the moon barely reached the ground."
        },
        {
          "camera": "medium",
          "on": "malfoy",
          "ms": 700
        },
        {
          "narrate": "Malfoy screamed and ran back down the path."
        },
        {
          "spawn": "hound",
          "at": "auto_threat"
        },
        {
          "sfx": "growl"
        },
        {
          "camera": "medium",
          "on": "hound",
          "ms": 700
        },
        {
          "move": "hound",
          "to": "auto_entry",
          "run": true,
          "async": true
        },
        {
          "narrate": "The hound bolted after him."
        },
        {
          "narrate": "Harry did not run."
        },
        {
          "camera": "close",
          "on": "harry",
          "ms": 600
        }
      ],
      "title": "The Forbidden Forest",
      "choice": {
        "prompt": "What should Harry do?",
        "seconds": 10,
        "options": [
          {
            "label": "Hold back",
            "correct": false,
            "goto": "scene_1_wrong"
          },
          {
            "label": "Step towards the clearing",
            "correct": true,
            "goto": "scene_2"
          }
        ]
      }
    },
    "scene_2": {
      "location": "forbidden_forest",
      "cast": {
        "harry": "auto_1",
        "malfoy": "auto_2",
        "hound": "auto_threat"
      },
      "beats": [
        {
          "camera": "medium",
          "on": "harry",
          "ms": 700
        },
        {
          "anim": "harry",
          "clip": "cast",
          "async": true
        },
        {
          "narrate": "He raised his wand and stepped towards the clearing."
        },
        {
          "narrate": "The hooded figure lifted its head and glided towards Harry."
        },
        {
          "camera": "medium",
          "on": "harry",
          "ms": 700
        },
        {
          "anim": "harry",
          "clip": "fall",
          "async": true,
          "hold": true
        },
        {
          "narrate": "Harry fell to his knees, clutching his forehead."
        },
        {
          "sfx": "thud"
        },
        {
          "narrate": "Hoofbeats thundered through the trees, and the hooded figure fled into the dark."
        }
      ],
      "ending": {
        "kind": "victory",
        "title": "The Forest",
        "text": "You followed Harry through “The Forest” the way the book tells it."
      }
    }
  }
